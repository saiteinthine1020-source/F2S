# Local development only. Copy this file to .env and never commit .env.
# Replace the password before starting PostgreSQL; never use a real or
# production credential here.
F2S_POSTGRES_DB=f2s_local
F2S_POSTGRES_USER=f2s_local_owner
F2S_POSTGRES_PASSWORD=replace-with-a-long-local-only-password
F2S_IDENTITY_DIGEST_KEY=replace-with-a-random-32-byte-local-key
F2S_FRONTEND_ORIGIN=http://127.0.0.1:5173
F2S_POSTGRES_HOST_PORT=5432
F2S_API_HOST_PORT=8000

# The API receives equivalent F2S_DATABASE_* variables from Compose. Direct
# host-side commands may set host=127.0.0.1 and reuse these local-only values.
F2S_DATABASE_SSLMODE=disable
